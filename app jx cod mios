    >
      {toast && (
        <div className="flex items-center gap-2.5 rounded-full bg-[#1A1110] px-5 py-3 text-sm font-semibold text-white shadow-xl">
          <CheckCircle2 size={17} strokeWidth={2} className="text-[#2D5A27]" />
          {toast}
        </div>
      )}
    </div>
  );
}

