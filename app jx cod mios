function Badge({ label }) {
  const conf = BADGE_STYLES[label] ?? { icon: Sparkles, className: "bg-[#2B1B17]/8 text-[#2B1B17]/70" };
  const Icon = conf.icon;
  return (
    <span className={`inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold ${conf.className}`}>
      <Icon size={11} strokeWidth={2.5} />
      {label}
    </span>
  );
}

function MenuCard({ item, index, onOpen }) {
  const { addItem } = useCart();
  const [justAdded, setJustAdded] = useState(false);
  const highlightBadge = item.badges.find((b) => b === "Recomandat" || b === "DOP");
  const secondaryBadges = item.badges.filter((b) => b !== highlightBadge);

  const handleAdd = (e) => {
    e.stopPropagation();
    addItem(item);
    setJustAdded(true);
    setTimeout(() => setJustAdded(false), 900);
  };

  return (
    <div
      className="card-reveal group flex flex-col overflow-hidden rounded-2xl border border-stone-200/80 bg-[#FDFBF7] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#2B1B17]/10"
      style={{ animationDelay: `${Math.min(index, 12) * 45}ms` }}
    >
      <button type="button" onClick={onOpen} className="relative block aspect-[4/3] w-full overflow-hidden" aria-label={`Vezi detalii pentru ${item.name}`}>
        <img src={item.image} alt={item.name} loading="lazy" className="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
        <div className="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1A1110]/35 via-transparent to-transparent" />
        <span className="absolute left-3 top-3 rounded-full bg-[#1A1110]/45 px-3 py-1 text-[11px] font-bold text-white backdrop-blur-md">{item.weight}</span>
        {highlightBadge && (
          <span className="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-[#2D5A27] px-2.5 py-1 text-[11px] font-bold text-white shadow-sm">
            {highlightBadge === "Recomandat" ? <Star size={11} strokeWidth={0} fill="currentColor" /> : <Award size={11} strokeWidth={2.5} />}
            {highlightBadge}
          </span>
        )}
      </button>

      <div className="flex flex-1 flex-col p-5">
        <button type="button" onClick={onOpen} className="text-left">
          <h3 className="font-serif text-lg font-semibold leading-snug text-[#1A1110] transition-colors group-hover:text-[#2D5A27]">{item.name}</h3>
          {secondaryBadges.length > 0 && (
            <div className="mt-2 flex flex-wrap gap-1.5">
              {secondaryBadges.map((b) => (
                <Badge key={b} label={b} />
              ))}
            </div>
          )}
          <p className="mt-3 text-[13.5px] leading-relaxed text-[#2B1B17]/70">
            {item.ingredients.map((ing, i) => (
              <span key={ing}>
                <span className={isGenericIngredient(ing) ? "" : "font-semibold text-[#2B1B17]"}>{ing}</span>
                {i < item.ingredients.length - 1 && ", "}
              </span>
            ))}
          </p>
        </button>

        <div className="mt-4 flex items-center justify-between border-t border-stone-200/70 pt-4">
          <span className="text-lg font-bold text-[#2B1B17]">{item.price} LEI</span>
          <button
            type="button"
            onClick={handleAdd}
            className={`flex items-center gap-1.5 rounded-full px-4 py-2.5 text-[13.5px] font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 ${
              justAdded ? "bg-[#1A1110]" : "bg-[#2D5A27] hover:bg-[#386633] hover:shadow-[#2D5A27]/25"
            }`}
          >
            {justAdded ? <CheckCircle2 size={15} strokeWidth={2.25} /> : <Plus size={15} strokeWidth={2.5} />}
            {justAdded ? "Adăugat" : "Adaugă"}
          </button>
        </div>
      </div>
    </div>
  );
}

function MenuSection() {
  const [activeTab, setActiveTab] = useState("toate");
  const [query, setQuery] = useState("");
  const [selected, setSelected] = useState(null);
  const [expanded, setExpanded] = useState(false);
  const { addItem } = useCart();

  useEffect(() => setExpanded(false), [activeTab]);
  const isSearching = query.trim().length > 0;

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    return ALL_ITEMS.filter((item) => {
      const matchesTab = activeTab === "toate" || item.category === activeTab;
      if (!matchesTab) return false;
      if (!q) return true;
      const haystack = [item.name, ...item.ingredients].join(" ").toLowerCase();
      return haystack.includes(q);
    });
  }, [activeTab, query]);

  const visibleItems = useMemo(() => {
    if (isSearching || expanded) return filtered;
    if (activeTab === "pizza") return filtered.slice(0, FEATURED_COUNT.pizza);
    if (activeTab === "panini") return filtered.slice(0, FEATURED_COUNT.panini);
    const pizza = filtered.filter((i) => i.category === "pizza").slice(0, FEATURED_COUNT.pizza);
    const panini = filtered.filter((i) => i.category === "panini").slice(0, FEATURED_COUNT.panini);
    return [...pizza, ...panini];
  }, [filtered, activeTab, isSearching, expanded]);

  const hiddenCount = filtered.length - visibleItems.length;

  useEffect(() => {
    if (!selected) return;
    const onKey = (e) => e.key === "Escape" && setSelected(null);
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [selected]);

  return (
    <section id="meniu" className="relative scroll-mt-20 bg-[#FDFBF7] px-5 py-16 sm:px-8 md:px-12 lg:px-16 xl:px-20">
      <div id="panini" className="mx-auto max-w-7xl">
        <div className="mb-8 max-w-2xl">
          <span className="text-xs font-semibold uppercase tracking-wide text-[#8C4A28]">Meniul Nostru</span>
          <h2 className="mt-2 font-serif text-3xl font-semibold tracking-tight text-[#1A1110] sm:text-4xl">Comandă Pizza Napoletană &amp; Panini Gourmet</h2>
        </div>

        <div className="relative mb-6 max-w-xl">
          <Search size={18} strokeWidth={2} className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#2B1B17]/40" />
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Caută un ingredient, ex: Mortadella, Burrata, Pesto..."
            className="w-full rounded-full border border-[#2B1B17]/12 bg-white py-3.5 pl-11 pr-11 text-[15px] text-[#1A1110] placeholder:text-[#2B1B17]/40 shadow-sm outline-none transition-all focus:border-[#2D5A27]/40 focus:ring-2 focus:ring-[#2D5A27]/15"
          />
          {query && (
            <button type="button" onClick={() => setQuery("")} aria-label="Șterge căutarea" className="absolute right-3 top-1/2 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full text-[#2B1B17]/40 hover:bg-[#2B1B17]/5 hover:text-[#2B1B17]">
              <X size={15} />
            </button>
          )}
        </div>

        <div className="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Categorii meniu">
          {TABS.map((tab) => {
            const active = activeTab === tab.key;
            return (
              <button
                key={tab.key}
                type="button"
                role="tab"
                aria-selected={active}
                onClick={() => setActiveTab(tab.key)}
                className={`rounded-full px-5 py-2.5 text-sm font-semibold transition-all ${
                  active ? "bg-[#2D5A27] text-white shadow-md shadow-[#2D5A27]/25" : "bg-[#F5EFE6] text-[#2B1B17]/70 hover:bg-[#2B1B17]/8"
                }`}
              >
                {tab.label} <span className={active ? "text-white/70" : "text-[#2B1B17]/40"}>({tab.count})</span>
              </button>
            );
          })}
        </div>

        {filtered.length === 0 ? (
          <div className="rounded-2xl border border-dashed border-[#2B1B17]/15 py-16 text-center">
            <p className="text-base font-medium text-[#2B1B17]/60">Niciun preparat nu conține &ldquo;{query}&rdquo;. Încearcă alt ingredient.</p>
          </div>
        ) : (
          <>
            <p className="mb-4 text-sm font-medium text-[#2B1B17]/50">
              {isSearching
                ? `${filtered.length} ${filtered.length === 1 ? "preparat" : "preparate"}`
                : expanded
                ? `${filtered.length} ${filtered.length === 1 ? "preparat" : "preparate"}`
                : `Cele mai populare — ${visibleItems.length} din ${filtered.length}`}
            </p>

            <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {visibleItems.map((item, i) => (
                <MenuCard key={item.id} item={item} index={i} onOpen={() => setSelected(item)} />
              ))}
            </div>

            {!isSearching && hiddenCount > 0 && (
              <div className="mt-10 flex justify-center">
                <button
                  type="button"
                  onClick={() => setExpanded(true)}
                  className="expand-btn group flex items-center gap-2 rounded-full border-2 border-[#2D5A27] bg-white px-7 py-3.5 text-[15px] font-semibold text-[#2D5A27] shadow-sm transition-all hover:bg-[#2D5A27] hover:text-white hover:shadow-lg hover:shadow-[#2D5A27]/20"
                >
                  Vezi toate preparatele
                  <span className="rounded-full bg-[#2D5A27]/10 px-2 py-0.5 text-xs font-bold text-[#2D5A27] group-hover:bg-white/20 group-hover:text-white">+{hiddenCount}</span>
                  <ChevronDown size={18} strokeWidth={2.5} className="expand-chevron" />
                </button>
              </div>
