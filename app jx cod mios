function CartDrawer() {
  const { items, incQty, decQty, removeItem, totalPrice, isDrawerOpen, closeDrawer, orderType, setOrderType } = useCart();

  useEffect(() => {
    if (!isDrawerOpen) return;
    const onKey = (e) => e.key === "Escape" && closeDrawer();
    window.addEventListener("keydown", onKey);
    document.body.style.overflow = "hidden";
    return () => {
      window.removeEventListener("keydown", onKey);
      document.body.style.overflow = "";
    };
  }, [isDrawerOpen, closeDrawer]);

  const buildWhatsAppMessage = () => {
    const lines = [
      "Comandă nouă — Mio Artegianale",
      "",
      ...items.map((i) => `• ${i.qty}× ${i.title} — ${i.qty * i.price} LEI`),
      "",
      `Total: ${totalPrice} LEI`,
      orderType === "ridicare" ? `Ridicare din: ${ADDRESS}` : "Livrare: Delivery în Cluj-Napoca",
    ];
    return encodeURIComponent(lines.join("\n"));
  };

  const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${buildWhatsAppMessage()}`;

  if (!isDrawerOpen) return null;

  return (
    <div className="fixed inset-0 z-[70] flex justify-end">
      <button type="button" aria-label="Închide coșul" onClick={closeDrawer} className="absolute inset-0 bg-[#1A1110]/50 backdrop-blur-[2px]" />
