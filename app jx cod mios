        <div className="flex items-center justify-between border-b border-[#2B1B17]/10 px-6 py-5">
          <h2 className="font-serif text-xl font-semibold text-[#1A1110]">Coșul tău</h2>
          <button type="button" onClick={closeDrawer} aria-label="Închide" className="flex h-10 w-10 items-center justify-center rounded-full text-[#2B1B17]/50 hover:bg-[#2B1B17]/5 hover:text-[#2B1B17]">
            <X size={20} />
