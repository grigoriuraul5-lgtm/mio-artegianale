                    <p className="mt-0.5 text-sm font-medium text-[#8C4A28]">{item.price} LEI</p>
                  </div>
                  <div className="flex items-center gap-1 rounded-full bg-[#F5EFE6] p-1">
                    <button
                      type="button"
