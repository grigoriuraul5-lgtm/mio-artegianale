  const { toast } = useCart();
  return (
    <div
      aria-live="polite"
      className={`pointer-events-none fixed left-1/2 top-24 z-[80] -translate-x-1/2 transition-all duration-300 ${
        toast ? "translate-y-0 opacity-100" : "-translate-y-3 opacity-0"
