const OPEN_HOUR = 11;
const CLOSE_HOUR = 22;

function useOpenStatus() {
  const [status, setStatus] = useState(null);
  useEffect(() => {
    const compute = () => {
      const now = new Date();
      const hour = now.getHours() + now.getMinutes() / 60;
      const isOpen = hour >= OPEN_HOUR && hour < CLOSE_HOUR;
      setStatus({ isOpen, label: isOpen ? "Deschis acum" : "Închis acum", detail: isOpen ? `Închide la ${CLOSE_HOUR}:00` : `Deschide la ${OPEN_HOUR}:00` });
    };
    compute();
    const id = setInterval(compute, 60 * 1000);
    return () => clearInterval(id);
  }, []);
  return status;
}

