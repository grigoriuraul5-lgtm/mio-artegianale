// ---------------------------------------------------------------------------
// CART CONTEXT — single source of truth, read/written by Header, MenuCard,
// CartDrawer and the mobile thumb-zone bar.
// ---------------------------------------------------------------------------

const CartContext = createContext(null);
const useCart = () => useContext(CartContext);

function CartProvider({ children }) {
  const [items, setItems] = useState([]); // { id, title, price, qty }
  const [isDrawerOpen, setDrawerOpen] = useState(false);
  const [orderType, setOrderType] = useState("ridicare"); // "ridicare" | "delivery"
  const [toast, setToast] = useState(null);
  const toastTimer = useRef(null);

  const showToast = (message) => {
    setToast(message);
    if (toastTimer.current) clearTimeout(toastTimer.current);
    toastTimer.current = setTimeout(() => setToast(null), 2200);
  };

  const addItem = (product) => {
    setItems((prev) => {
      const existing = prev.find((i) => i.id === product.id);
      if (existing) {
        return prev.map((i) => (i.id === product.id ? { ...i, qty: i.qty + 1 } : i));
      }
      return [...prev, { id: product.id, title: product.name, price: product.price, qty: 1 }];
    });
    showToast(`${product.name} adăugat în coș`);
  };

  const incQty = (id) => setItems((prev) => prev.map((i) => (i.id === id ? { ...i, qty: i.qty + 1 } : i)));
  const decQty = (id) =>
    setItems((prev) =>
      prev.flatMap((i) => (i.id === id ? (i.qty <= 1 ? [] : [{ ...i, qty: i.qty - 1 }]) : [i]))
    );
  const removeItem = (id) => setItems((prev) => prev.filter((i) => i.id !== id));

  const totalCount = useMemo(() => items.reduce((sum, i) => sum + i.qty, 0), [items]);
  const totalPrice = useMemo(() => items.reduce((sum, i) => sum + i.qty * i.price, 0), [items]);

  const value = {
    items,
    addItem,
    incQty,
    decQty,
    removeItem,
    totalCount,
    totalPrice,
    isDrawerOpen,
    openDrawer: () => setDrawerOpen(true),
    closeDrawer: () => setDrawerOpen(false),
    orderType,
    setOrderType,
    toast,
  };

  return <CartContext.Provider value={value}>{children}</CartContext.Provider>;
}

